# Flask secret key - used to sign session cookies. Change this to any random string.
SECRET_KEY=change_this_to_a_random_secret_key

# Database URL.
# Default (SQLite - works out of the box, no setup needed):
DATABASE_URL=sqlite:///finance.db

# To use MySQL instead, comment the line above and use something like:
# DATABASE_URL=mysql+pymysql://username:password@localhost/finance_db

# AI configuration (OPTIONAL).
# Leave AI_API_KEY empty to use the built-in rule-based recommendation engine.
# Supported providers: "openai" or "gemini"
AI_PROVIDER=
AI_API_KEY=
